{
  "name": "@debtshift/protocols",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "test": "vitest run --dir src --passWithNoTests",
    "test:deployment": "vitest run src/production-deployment.integration.test.ts src/testnet-morpho-deployment.integration.test.ts src/vault-funding.integration.test.ts",
    "test:fork": "vitest run src/protocol-fork.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@debtshift/domain": "0.1.0",
    "viem": "2.57.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@debtshift/intents": "0.1.0",
    "@debtshift/optimizer": "0.1.0"
  }
}
