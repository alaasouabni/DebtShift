    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "bullmq": "6.7.2",
    "ioredis": "6.0.0",
    "near-api-js": "6.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "drizzle-orm": "0.45.4",
    "tsx": "4.23.15"
  }
