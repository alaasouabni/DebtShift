NODE_ENV=development
DEBTSHIFT_MODE=sandbox
MARKET_DATA_PROVIDER=SIMULATOR
LIVE_MARKET_CONFIG_JSON=
EVM_DEPLOYMENT_MANIFEST_PATH=
# Required in testnet mode; proves the canonical DebtShift-operated Morpho deployment and funded market.
TESTNET_MORPHO_DEPLOYMENT_MANIFEST_PATH=

WEB_PORT=3000
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=debtshift
POSTGRES_USER=debtshift
POSTGRES_PASSWORD=debtshift_local
DATABASE_URL=postgresql://debtshift:debtshift_local@localhost:5432/debtshift

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

SOURCE_CHAIN_ID=31337
SOURCE_RPC_URL=http://localhost:8545
# Required explicitly for testnet/mainnet; bounds canonical event replay to this deployment.
SOURCE_DEPLOYMENT_BLOCK_NUMBER=0
SOURCE_FINALITY_CONFIRMATIONS=1
# Bounded headroom for variable-debt accrual between planning and atomic source close.
SOURCE_DEBT_BUFFER_BPS=10
DESTINATION_CHAIN_ID=31338
DESTINATION_RPC_URL=http://localhost:8546
# Required explicitly for testnet/mainnet; bounds canonical event replay to this deployment.
DESTINATION_DEPLOYMENT_BLOCK_NUMBER=0
DESTINATION_FINALITY_CONFIRMATIONS=1
EIP712_VERIFYING_CONTRACT=0x5fc8d32690cc91d4c39d9d3abcbd16989f875707
SANDBOX_EXECUTOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EXECUTOR_PRIVATE_KEY=
SOURCE_DEBT_TOKEN_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
SOURCE_COLLATERAL_TOKEN_ADDRESS=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
SOURCE_LENDING_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0
SOURCE_VAULT_ADDRESS=0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9
SOURCE_ESCROW_ADDRESS=0xdc64a140aa3e981100a9beca4e685f962f0cf6c9
SOURCE_ADAPTER_ADDRESS=0x5fc8d32690cc91d4c39d9d3abcbd16989f875707
DESTINATION_DEBT_TOKEN_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
DESTINATION_COLLATERAL_TOKEN_ADDRESS=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
DESTINATION_LENDING_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0
DESTINATION_ESCROW_ADDRESS=0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9
DESTINATION_ADAPTER_ADDRESS=0xdc64a140aa3e981100a9beca4e685f962f0cf6c9
EXECUTOR_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

TRANSPORT_PROVIDER=DEBTSHIFT_SIMULATOR
INTENTS_MODE=simulated
INTENTS_BASE_URL=https://1click.chaindefuser.com
INTENTS_AUTH_TOKEN=
INTENTS_REQUEST_TIMEOUT_MS=8000
INTENTS_RESPONSE_LIMIT_BYTES=1000000
INTENTS_CATALOG_CACHE_TTL_MS=600000
INTENTS_MAX_ATTEMPTS=3
INTENTS_RETRY_BASE_DELAY_MS=200
INTENTS_RETRY_MAX_DELAY_MS=2000
INTENTS_CIRCUIT_FAILURE_THRESHOLD=5
INTENTS_CIRCUIT_RESET_MS=30000
INTENTS_RATE_LIMIT_CAPACITY=10
INTENTS_RATE_LIMIT_WINDOW_MS=1000
INTENTS_CACHE_MAX_ENTRIES=100
# Bounded durable command retries. Transport ambiguity is still capped by the signed plan deadline.
WORKFLOW_COMMAND_MAX_ATTEMPTS=25
WORKFLOW_COMMAND_RETRY_DELAY_MS=500
WORKFLOW_COMMAND_RETRY_MAX_DELAY_MS=30000
WORKFLOW_COMMAND_STALE_AFTER_MS=300000
ALERT_SCAN_INTERVAL_MS=30000
ALERT_DEADLINE_LEAD_MS=60000
ALERT_STALE_MIGRATION_MS=300000
ALERT_STALE_RECOVERY_MS=900000
SIMULATOR_TERMINAL_OUTCOME=SUCCESS
SIMULATOR_PROCESSING_POLLS=1

NEAR_NETWORK=sandbox
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_RPC_FALLBACK_URLS_JSON=[]
NEAR_REGISTRY_ACCOUNT=
NEAR_REGISTRY_OWNER_ACCOUNT=
NEAR_REGISTRY_WASM_SHA256=
NEAR_SIGNER_ACCOUNT_ID=
NEAR_SIGNER_PRIVATE_KEY=
# Refunded automatically by the registry except for storage actually consumed.
NEAR_STORAGE_DEPOSIT_YOCTO=1000000000000000000000000
NEAR_FUNCTION_CALL_GAS=100000000000000

AGENT_MODE=DETERMINISTIC
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
ALLOW_CUSTOM_AI_ENDPOINTS=false

MAINNET_EXECUTION_ENABLED=false

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
