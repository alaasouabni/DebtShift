{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [{ "expr": "up{job=\"debtshift-api\"}", "refId": "A" }],
      "title": "API scrape health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        { "expr": "time() - debtshift_metrics_collected_timestamp_seconds", "refId": "A" }
      ],
      "title": "Metrics snapshot age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [{ "expr": "debtshift_ledger_unexplained_imbalance_units", "refId": "A" }],
      "title": "Unexplained ledger imbalance",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 13, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "expr": "sum(debtshift_outbox_messages{status=~\"PENDING|FAILED_RETRYABLE\"})",
          "refId": "A"
        }
      ],
      "title": "Outbox backlog",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [{ "expr": "sum(debtshift_operational_alerts{status=\"OPEN\"})", "refId": "A" }],
      "title": "Open operational alerts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{ "expr": "debtshift_migrations", "legendFormat": "{{phase}}", "refId": "A" }],
      "title": "Migrations by phase",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, phase) (debtshift_migration_phase_age_seconds_bucket))",
          "legendFormat": "p95 {{phase}}",
          "refId": "A"
        }
      ],
      "title": "Current phase age p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (type, status) (debtshift_commands{status=~\"FAILED_RETRYABLE|FAILED_TERMINAL\"})",
          "legendFormat": "{{type}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Command failures",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "debtshift-prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(debtshift_command_attempts_total[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "title": "Command attempt rate",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["debtshift", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "DebtShift Operations",
  "uid": "debtshift-operations",
  "version": 1
}
